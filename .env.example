# Any OpenAI-compatible endpoint with a vision-capable model.
# Examples:
#   OpenAI:      https://api.openai.com/v1                 gpt-4.1-mini
#   Groq:        https://api.groq.com/openai/v1            qwen/qwen3.8-27b  (only Groq vision model, preview)
#   OpenRouter:  https://openrouter.ai/api/v1              <any vision model>
#   Ollama:      http://localhost:11434/v1                 qwen2.5vl
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=qwen/qwen3.8-27b
